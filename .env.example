# REQUIRED. The service refuses to start without it. Use a long random string.
SPEECH_API_KEY=

# Whisper model. Raise to "medium" only if accuracy on real recordings isn't good enough.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# 0 = let faster-whisper pick
WHISPER_CPU_THREADS=0
# Mount a Railway volume here so the model downloads once, not on every deploy.
MODEL_CACHE_DIR=/models

# Limits
MAX_UPLOAD_MB=1024
# Longest audio POST /v1/transcribe accepts (15 min). Longer -> use POST /v1/jobs.
SYNC_MAX_SECONDS=900
# Long audio is transcribed in pieces this long (30 min).
CHUNK_SECONDS=1800
JOB_WORKERS=1
# Requests per minute, per API key.
RATE_LIMIT_PER_MIN=30

# Job storage: "memory" (default) or "supabase" (run sql/001_speech_jobs.sql first).
JOB_STORE=memory
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# PORT is provided by Railway.
